<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="static_world">
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <uniform_fluid_density>1000</uniform_fluid_density>
    </plugin>

    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Дно (плоскость) -->
    <model name="ground_plane">
    <pose>0 0 -50 0 0 0</pose>
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 50 статических объектов (разные формы, размеры, расположены случайно в пределах -200..200 по X,Y, на глубине -19..-18) -->
    <!-- Объект 1: большой куб -->
    <model name="obj_01">
      <static>true</static>
      <pose>-150.2 80.5 -19.2 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>2.0 2.0 2.0</size></box></geometry><material><ambient>0.8 0.2 0.2 1</ambient></material></visual><collision name="collision"><geometry><box><size>2.0 2.0 2.0</size></box></geometry></collision></link>
    </model>

    <!-- Объект 2: сфера -->
    <model name="obj_02">
      <static>true</static>
      <pose>-120.5 -90.3 -19.5 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><sphere><radius>1.5</radius></sphere></geometry><material><ambient>0.2 0.8 0.2 1</ambient></material></visual><collision name="collision"><geometry><sphere><radius>1.5</radius></sphere></geometry></collision></link>
    </model>

    <!-- Объект 3: цилиндр -->
    <model name="obj_03">
      <static>true</static>
      <pose>180.2 40.1 -19.0 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><cylinder><radius>1.0</radius><length>2.5</length></cylinder></geometry><material><ambient>0.2 0.2 0.8 1</ambient></material></visual><collision name="collision"><geometry><cylinder><radius>1.0</radius><length>2.5</length></cylinder></geometry></collision></link>
    </model>

    <!-- Объект 4: плоский куб -->
    <model name="obj_04">
