<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="submarine">
    
    <!-- ========================================== -->
    <!-- 0. ГЛОБАЛЬНАЯ ПОЗИЦИЯ И ОРИЕНТАЦИЯ         -->
    <!-- ========================================== -->
    <!-- Поворот на 90° по X и 90° по Y задаёт начальную ориентацию в мире -->
    <pose>0 0 0 1.5707963267948966 1.5707963267948966 0</pose>

    <!-- ========================================== -->
    <!-- 1. ОСНОВНОЙ КОРПУС (BODY)                  -->
    <!-- ========================================== -->
    <link name="body">
      <pose>0 0 0 0 1.5707963267948966 0</pose>
      <inertial>
        <pose>0.51 0 -0.02 0 0 0</pose>
        <mass>118.2</mass>
        <inertia>
          <ixx>1.64</ixx>
          <iyy>18.33</iyy>
          <izz>18.33</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="body_visual">
        <geometry>
          <cylinder>
            <radius>0.1666667</radius>
            <length>1.3333333</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.5 0.8 1</ambient>
        </material>
      </visual>

      <collision name="body_collision">
        <geometry>
          <cylinder>
            <radius>0.1666667</radius>
            <length>1.3333333</length>
          </cylinder>
        </geometry>
      </collision>

      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>/model/submarine/imu</topic>
      </sensor>

      <sensor name="pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>/sub_press</topic>
      </sensor>
    </link>

    <!-- ========================================== -->
    <!-- 2. ЛЕВЫЙ ПРОПЕЛЛЕР И ЕГО ФИЗИКА            -->
    <!-- ========================================== -->
    <link name="left_propeller">
      <pose>0 0.2833333 0 0 1.5708 0</pose>
      <inertial>
        <mass>0.101</mass>
        <inertia>
          <ixx>0.0000592</ixx>
          <iyy>0.0000592</iyy>
          <izz>0.000117</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Визуализация лопастей и ступицы -->
      <visual name="lp_cyl"><geometry><cylinder><radius>0.0333</radius><length>0.03</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      <visual name="lp_b1"><pose>0.057 0 0 -0.349066 0 0</pose><geometry><box><size>0.1 0.05 0.01</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      <visual name="lp_b2"><pose>-0.057 0 0 0.349066 0 0</pose><geometry><box><size>0.1 0.05 0.01</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      <visual name="lp_b3"><pose>0 0.057 0 0 -0.349066 0</pose><geometry><box><size>0.05 0.1 0.01</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      <visual name="lp_b4"><pose>0 -0.057 0 0 0.349066  0</pose><geometry><box><size>0.05 0.1 0.01</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>

      <!-- Коллизии лопастей -->
      <collision name="lp_c1"><pose>0.057 0 0 -0.349066 0 0</pose><geometry><box><size>0.1 0.05 0.01</size></box></geometry></collision>
      <collision name="lp_c2"><pose>-0.057 0 0 0.349066 0 0</pose><geometry><box><size>0.1 0.05 0.01</size></box></geometry></collision>
      <collision name="lp_c3"><pose>0 0.057 0 0 -0.349066 0</pose><geometry><box><size>0.05 0.1 0.01</size></box></geometry></collision>
      <collision name="lp_c4"><pose>0 -0.057 0 0 0.349066 0</pose><geometry><box><size>0.05 0.1 0.01</size></box></geometry></collision>
    </link>

    <joint name="left_propeller_joint" type="revolute">
      <parent>body</parent>
      <child>left_propeller</child>
      <axis>
        <xyz>1 0 0</xyz>
        <use_parent_model_frame>1</use_parent_model_frame>
        <limit><lower>-1e12</lower><upper>1e12</upper></limit>
        <dynamics><damping>0.1</damping></dynamics>
      </axis>
    </joint>

    <!-- Плагин создания тяги на суставе -->
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>left_propeller_joint</joint_name>
    </plugin>
        <!-- ===================== ЛЕВЫЙ ПРОПЕЛЛЕР: LiftDrag ===================== -->
    <!-- Лопасть 1: cp=(+X), vel→(-Y) ✅ БЕЗ ИЗМЕНЕНИЙ -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>

      <cla>2.5</cla>
      <cla_stall>-0.8</cla_stall>
      <cda>0.02</cda>
      <cda_stall>1.2</cda_stall>
      <alpha_stall>0.30</alpha_stall>
      <area>0.005</area>
      <upward>0 -0.7071067811865476 -0.7071067811865475</upward>
      <forward>0 -0.7071067811865475 0.7071067811865476</forward>
      <link_name>left_propeller</link_name>
      <cp>0.05833 0 0</cp>
    </plugin>

    <!-- Лопасть 2: cp=(-Y), vel→(-X) ✅ БЕЗ ИЗМЕНЕНИЙ -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>2.5</cla>
      <cla_stall>-0.8</cla_stall>
      <cda>0.02</cda>
      <cda_stall>1.2</cda_stall>
      <alpha_stall>0.30</alpha_stall>
      <area>0.005</area>
      <upward>-0.7071067811865475 0 -0.7071067811865476</upward>
      <forward>-0.7071067811865476 0 0.7071067811865475</forward>
      <link_name>left_propeller</link_name>
      <cp>0 -0.05833 0</cp>
    </plugin>

    <!-- Лопасть 3: cp=(-X), vel→(+Y) ⚠️ ИСПРАВЛЕН forward! -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>2.5</cla>
      <cla_stall>-0.8</cla_stall>
      <cda>0.02</cda>
      <cda_stall>1.2</cda_stall>
      <alpha_stall>0.30</alpha_stall>
      <area>0.005</area>
      <upward>0 0.7071067811865475 -0.7071067811865476</upward>
      <!-- БЫЛО: <forward>0 -0.7071067811865476 -0.7071067811865475</forward> -->
      <!-- СТАЛО: инвертированы ОБЕ компоненты Y и Z -->
      <forward>0 0.7071067811865476 0.7071067811865475</forward>
      <link_name>left_propeller</link_name>
      <cp>-0.05833 0 0</cp>
    </plugin>

    <!-- Лопасть 4: cp=(+Y), vel→(+X) ✅ БЕЗ ИЗМЕНЕНИЙ -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>2.5</cla>
      <cla_stall>-0.8</cla_stall>
      <cda>0.02</cda>
      <cda_stall>1.2</cda_stall>
      <alpha_stall>0.30</alpha_stall>
      <area>0.005</area>
      <upward>0.7071067811865476 0 -0.7071067811865475</upward>
      <forward>0.7071067811865475 0 0.7071067811865476</forward>
      <link_name>left_propeller</link_name>
      <cp>0 0.05833 0</cp>
    </plugin>

    <!-- ========================================== -->
    <!-- 3. ПРАВЫЙ ПРОПЕЛЛЕР И ЕГО ФИЗИКА           -->
    <!-- ========================================== -->
    <link name="right_propeller">
      <pose>0 -0.2833333 0 0 1.5708 0</pose>
      <inertial>
        <mass>0.101</mass>
        <inertia>
          <ixx>0.0000592</ixx>
          <iyy>0.0000592</iyy>
          <izz>0.000117</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="rp_cyl"><geometry><cylinder><radius>0.0333</radius><length>0.03</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      <visual name="rp_b1"><pose>0.057 0 0 0.349066 0 0</pose><geometry><box><size>0.1 0.05 0.01</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      <visual name="rp_b2"><pose>-0.057 0 0 -0.349066 0 0</pose><geometry><box><size>0.1 0.05 0.01</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      <visual name="rp_b3"><pose>0 0.057 0 0 0.349066 0</pose><geometry><box><size>0.05 0.1 0.01</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      <visual name="rp_b4"><pose>0 -0.057 0 0 -0.349066 0</pose><geometry><box><size>0.05 0.1 0.01</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>

      <collision name="rp_c1"><pose>0.057 0 0 0.349066 0 0</pose><geometry><box><size>0.1 0.05 0.01</size></box></geometry></collision>
      <collision name="rp_c2"><pose>-0.057 0 0 -0.349066 0 0</pose><geometry><box><size>0.1 0.05 0.01</size></box></geometry></collision>
      <collision name="rp_c3"><pose>0 0.057 0 0 0.349066 0</pose><geometry><box><size>0.05 0.1 0.01</size></box></geometry></collision>
      <collision name="rp_c4"><pose>0 -0.057 0 0 -0.349066 0</pose><geometry><box><size>0.05 0.1 0.01</size></box></geometry></collision>
    </link>

    <joint name="right_propeller_joint" type="revolute">
      <parent>body</parent>
      <child>right_propeller</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <use_parent_model_frame>1</use_parent_model_frame>
        <limit><lower>-1e12</lower><upper>1e12</upper></limit>
        <dynamics><damping>0.1</damping></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>right_propeller_joint</joint_name>
    </plugin>

        <!-- Гидродинамика 4-х лопастей правого винта -->
        <!-- ===================== ПРАВЫЙ ПРОПЕЛЛЕР: LiftDrag ===================== -->
    <!-- Лопасть 1: cp=(+X), vel→(+Y) ✅ БЕЗ ИЗМЕНЕНИЙ -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>2.5</cla>
      <cla_stall>-0.8</cla_stall>
      <cda>0.02</cda>
      <cda_stall>1.2</cda_stall>
      <alpha_stall>0.30</alpha_stall>
      <area>0.005</area>
      <upward>0 0.7071067811865476 -0.7071067811865475</upward>
      <forward>0 0.7071067811865475 0.7071067811865476</forward>
      <link_name>right_propeller</link_name>
      <cp>0.05833 0 0</cp>
    </plugin>

    <!-- Лопасть 2: cp=(-Y), vel→(+X) ⚠️ ИСПРАВЛЕН forward! -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>2.5</cla>
      <cla_stall>-0.8</cla_stall>
      <cda>0.02</cda>
      <cda_stall>1.2</cda_stall>
      <alpha_stall>0.30</alpha_stall>
      <area>0.005</area>
      <upward>0.7071067811865475 0 -0.7071067811865476</upward>
      <!-- БЫЛО: <forward>-0.7071067811865476 0 0.7071067811865475</forward> -->
      <!-- СТАЛО: X-компонента инвертирована с - на + -->
      <forward>0.7071067811865476 0 0.7071067811865475</forward>
      <link_name>right_propeller</link_name>
      <cp>0 -0.05833 0</cp>
    </plugin>

    <!-- Лопасть 3: cp=(-X), vel→(-Y) ⚠️ ИСПРАВЛЕН forward! -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>2.5</cla>
      <cla_stall>-0.8</cla_stall>
      <cda>0.02</cda>
      <cda_stall>1.2</cda_stall>
      <alpha_stall>0.30</alpha_stall>
      <area>0.005</area>
      <upward>0 -0.7071067811865475 -0.7071067811865476</upward>
      <!-- БЫЛО: <forward>0 -0.7071067811865476 -0.7071067811865475</forward> -->
      <!-- СТАЛО: Z-компонента инвертирована с - на + -->
      <forward>0 -0.7071067811865476 0.7071067811865475</forward>
      <link_name>right_propeller</link_name>
      <cp>-0.05833 0 0</cp>
    </plugin>

    <!-- Лопасть 4: cp=(+Y), vel→(-X) ⚠️ ИСПРАВЛЕН forward! -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>2.5</cla>
      <cla_stall>-0.8</cla_stall>
      <cda>0.02</cda>
      <cda_stall>1.2</cda_stall>
      <alpha_stall>0.30</alpha_stall>
      <area>0.005</area>
      <upward>-0.7071067811865476 0 -0.7071067811865475</upward>
      <!-- БЫЛО: <forward>0.7071067811865475 0 0.7071067811865476</forward> -->
      <!-- СТАЛО: X-компонента инвертирована с + на - -->
      <forward>-0.7071067811865475 0 0.7071067811865476</forward>
      <link_name>right_propeller</link_name>
      <cp>0 0.05833 0</cp>
    </plugin>

    <!-- ========================================== -->
    <!-- 4. РУЛИ УПРАВЛЕНИЯ (CONTROL SURFACES)      -->
    <!-- ========================================== -->
    
    <!-- Горизонтальный правый руль -->
    <link name="horizontal_rudder_right">
      <pose>-0.6666667 0.2833333 0 1.5708 0 1.5708</pose>
      <inertial><mass>0.02315</mass><inertia><ixx>0.00000129</ixx><iyy>0.00000129</iyy><izz>0.00000129</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="hrr_v"><geometry><box><size>0.1666667 0.0083333 0.0833333</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient></material></visual>
      <collision name="hrr_c"><geometry><box><size>0.05 0.0083333 0.0833333</size></box></geometry></collision>
    </link>
    <joint name="horizontal_rudder_right_joint" type="revolute">
      <parent>body</parent><child>horizontal_rudder_right</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-0.785</lower><upper>0.785</upper><effort>10</effort><velocity>1.0</velocity></limit><dynamics><damping>3.0</damping></dynamics></axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>horizontal_rudder_right_joint</joint_name>
      <topic>/model/submarine/joint/horizontal_rudder_right/cmd_position</topic>
      <p_gain>10</p_gain>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density><link_name>horizontal_rudder_right</link_name>

      <area>0.014</area>
      <cla>2.5</cla>
      <cla_stall>-0.5</cla_stall>
      <cda>0.02</cda>
      <cda_stall>1.0</cda_stall>
      <alpha_stall>0.30</alpha_stall><a0>0</a0>
      <upward>0 1 0</upward><forward>0 0 1</forward>
      <cp>0 0 0</cp>
    </plugin>

    <!-- Горизонтальный левый руль -->
    <link name="horizontal_rudder_left">
      <pose>-0.6666667 -0.2833333 0 1.5708 0 1.5708</pose>
      <inertial><mass>0.02315</mass><inertia><ixx>0.00000129</ixx><iyy>0.00000129</iyy><izz>0.00000129</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="hrl_v"><geometry><box><size>0.1666667 0.0083333 0.0833333</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient></material></visual>
      <collision name="hrl_c"><geometry><box><size>0.05 0.0083333 0.0833333</size></box></geometry></collision>
    </link>
    <joint name="horizontal_rudder_left_joint" type="revolute">
      <parent>body</parent><child>horizontal_rudder_left</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-0.785</lower><upper>0.785</upper><effort>10</effort><velocity>1.0</velocity></limit><dynamics><damping>3.0</damping></dynamics></axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>horizontal_rudder_left_joint</joint_name>
      <topic>/model/submarine/joint/horizontal_rudder_left/cmd_position</topic>
      <p_gain>10</p_gain>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density><link_name>horizontal_rudder_left</link_name>
      <area>0.014</area>
      <cla>2.5</cla>
      <cla_stall>-0.5</cla_stall>
      <cda>0.02</cda>
      <cda_stall>1.0</cda_stall>
      <alpha_stall>0.30</alpha_stall><a0>0</a0>
      <upward>0 1 0</upward><forward>0 0 1</forward>
      <cp>0 0 0</cp>
    </plugin>

    <!-- Вертикальный руль -->
    <link name="vertical_rudder">
      <pose>-0.7666667 0 -0.2833333 1.5708 1.5708 0</pose>
      <inertial><mass>0.02315</mass><inertia><ixx>0.00000129</ixx><iyy>0.00000129</iyy><izz>0.00000129</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="vr_v"><geometry><box><size>0.1666667 0.1666667 0.005</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient></material></visual>
      <collision name="vr_c"><geometry><box><size>0.0333333 0.0666667 0.005</size></box></geometry></collision>
    </link>
    <joint name="vertical_rudder_joint" type="revolute">
      <parent>body</parent><child>vertical_rudder</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-0.785</lower><upper>0.785</upper><effort>10</effort><velocity>1.0</velocity></limit><dynamics><damping>3.0</damping></dynamics></axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>vertical_rudder_joint</joint_name>
      <topic>/model/submarine/joint/vertical_rudder/cmd_position</topic>
      <p_gain>10</p_gain>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density><link_name>vertical_rudder</link_name>
      <area>0.014</area>
      <cla>2.5</cla>
      <cla_stall>-0.5</cla_stall>
      <cda>0.02</cda>
      <cda_stall>1.0</cda_stall>
      <alpha_stall>0.30</alpha_stall><a0>0</a0>
      <upward>0 0 1</upward><forward>0 1 0</forward>
      <cp>0 0 0</cp>
    </plugin>

    <!-- ========================================== -->
    <!-- 5. БАЛЛАСТЫ (BALLAST)                      -->
    <!-- ========================================== -->
    <link name="ballast_1">
      <pose>0.49 0 -0.2 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
      </inertial>
      <visual name="b1_v"><geometry><box><size>0.32 0.05 0.05</size></box></geometry><material><ambient>0.8 0.2 0.2 1</ambient></material></visual>
      <collision name="b1_c"><geometry><box><size>0.32 0.05 0.05</size></box></geometry></collision>
    </link>
    <joint name="ballast_1_joint" type="fixed"><parent>body</parent><child>ballast_1</child></joint>

    <link name="ballast_2">
      <pose>0.17 0 -0.2 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
      </inertial>
      <visual name="b2_v"><geometry><box><size>0.32 0.05 0.05</size></box></geometry><material><ambient>0.8 0.2 0.2 1</ambient></material></visual>
      <collision name="b2_c"><geometry><box><size>0.32 0.05 0.05</size></box></geometry></collision>
    </link>
    <joint name="ballast_2_joint" type="fixed"><parent>body</parent><child>ballast_2</child></joint>

    <link name="ballast_3">
      <pose>-0.17 0 -0.2 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
      </inertial>
      <visual name="b3_v"><geometry><box><size>0.32 0.05 0.05</size></box></geometry><material><ambient>0.8 0.2 0.2 1</ambient></material></visual>
      <collision name="b3_c"><geometry><box><size>0.32 0.05 0.05</size></box></geometry></collision>
    </link>
    <joint name="ballast_3_joint" type="fixed"><parent>body</parent><child>ballast_3</child></joint>

    <link name="ballast_4">
      <pose>-0.49 0 -0.2 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
      </inertial>
      <visual name="b4_v"><geometry><box><size>0.32 0.05 0.05</size></box></geometry><material><ambient>0.8 0.2 0.2 1</ambient></material></visual>
      <collision name="b4_c"><geometry><box><size>0.32 0.05 0.05</size></box></geometry></collision>
    </link>
    <joint name="ballast_4_joint" type="fixed"><parent>body</parent><child>ballast_4</child></joint>

    <plugin filename="gz-sim-buoyancy-engine-system" name="gz::sim::systems::BuoyancyEngine">
      <link_name>ballast_1</link_name>
      <min_volume>0.0</min_volume>
      <max_volume>0.003</max_volume> 
    </plugin>

    <plugin filename="gz-sim-buoyancy-engine-system" name="gz::sim::systems::BuoyancyEngine">
      <link_name>ballast_2</link_name>
      <min_volume>0.0</min_volume>
      <max_volume>0.003</max_volume>
    </plugin>

    <plugin filename="gz-sim-buoyancy-engine-system" name="gz::sim::systems::BuoyancyEngine">
      <link_name>ballast_3</link_name>
      <min_volume>0.0</min_volume>
      <max_volume>0.003</max_volume>
    </plugin>

    <plugin filename="gz-sim-buoyancy-engine-system" name="gz::sim::systems::BuoyancyEngine">
      <link_name>ballast_4</link_name>
      <min_volume>0.0</min_volume>
      <max_volume>0.003</max_volume>
    </plugin>


    <!-- ========================================== -->
    <!-- 6. СИСТЕМНЫЕ ПЛАГИНЫ                       -->
    <!-- ========================================== -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>submarine/body</robot_base_frame>
      <odom_topic>/model/submarine/odometry</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <!-- Звено, к которому применяются силы (ваш корпус) -->
      <link_name>body</link_name>

      <!-- Линейное и квадратичное сопротивление по осям X, Y, Z (поступательное движение) -->
      <xU>-0.76</xU>         <!-- линейное сопротивление вперёд-назад -->
      <xUabsU>-15.27</xUabsU> <!-- квадратичное сопротивление вперёд-назад -->
      <yV>-11.11</yV>         <!-- линейное сопротивление вбок -->
      <yVabsV>-222.22</yVabsV> <!-- квадратичное сопротивление вбок -->
      <zW>-11.11</zW>         <!-- линейное сопротивление вверх-вниз -->
      <zWabsW>-222.22</zWabsW> <!-- квадратичное сопротивление вверх-вниз -->

      <!-- Вращательное сопротивление (демпфирование) для крена, тангажа и рыскания -->
      <kP>-3.95</kP>          <!-- линейное сопротивление крену -->
      <kPabsP>-79.01</kPabsP>  <!-- квадратичное сопротивление крену -->
      <mQ>-3.95</mQ>          <!-- линейное сопротивление тангажу -->
      <mQabsQ>-79.01</mQabsQ>  <!-- квадратичное сопротивление тангажу -->
      <nR>-3.95</nR>          <!-- линейное сопротивление рысканию -->
      <nRabsR>-79.01</nRabsR>  <!-- квадратичное сопротивление рысканию -->



    </plugin>




    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>horizontal_rudder_right</link_name>
      <xU>-0.2</xU>         <xUabsU>-0.5</xUabsU>
      <yV>-0.4</yV>         <yVabsV>-1.0</yVabsV>
      <zW>-0.4</zW>         <zWabsW>-1.0</zWabsW>
      <kP>-0.02</kP>        <kPabsP>-0.05</kPabsP>
      <mQ>-0.02</mQ>        <mQabsQ>-0.05</mQabsQ>
      <nR>-0.02</nR>        <nRabsR>-0.05</nRabsR>
    </plugin>


    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>horizontal_rudder_left</link_name>
      <xU>-0.2</xU>         <xUabsU>-0.5</xUabsU>
      <yV>-0.4</yV>         <yVabsV>-1.0</yVabsV>
      <zW>-0.4</zW>         <zWabsW>-1.0</zWabsW>
      <kP>-0.02</kP>        <kPabsP>-0.05</kPabsP>
      <mQ>-0.02</mQ>        <mQabsQ>-0.05</mQabsQ>
      <nR>-0.02</nR>        <nRabsR>-0.05</nRabsR>
    </plugin>

    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>vertical_rudder</link_name>
      <xU>-0.2</xU>         <xUabsU>-0.5</xUabsU>
      <yV>-0.4</yV>         <yVabsV>-1.0</yVabsV>
      <zW>-0.4</zW>         <zWabsW>-1.0</zWabsW>
      <kP>-0.02</kP>        <kPabsP>-0.05</kPabsP>
      <mQ>-0.02</mQ>        <mQabsQ>-0.05</mQabsQ>
      <nR>-0.02</nR>        <nRabsR>-0.05</nRabsR>
    </plugin>






  </model>
</sdf>