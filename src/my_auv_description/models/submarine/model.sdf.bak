    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>1.2535816618911175</cla> <cla_stall>-1.4326647564469914</cla_stall>
      <cda>0</cda> <cda_stall>1.4326647564469914</cda_stall>
      <alpha_stall>1.396</alpha_stall> <a0>0</a0>
      <area>0.007677</area>
      <upward>0.7071067811865476 0 -0.7071067811865475</upward>
      <forward>0.7071067811865475 0 0.7071067811865476</forward>
      <link_name>right_propeller</link_name>
      <cp>0 0.05833 0</cp>
    </plugin>

    <!-- ========== ГОРИЗОНТАЛЬНЫЕ РУЛИ (масштабированы) ========== -->
    <!-- Правый горизонтальный руль -->
    <link name="horizontal_rudder_right">
      <pose>-0.6666667 0.2833333 0 1.5708 0 1.5708</pose>   <!-- (-4)/6 = -0.6667, 1.7/6=0.2833 -->
      <inertial>
        <mass>0.02315</mass>   <!-- 5 / 216 -->
        <inertia>
          <ixx>0.00000129</ixx> <iyy>0.00000129</iyy> <izz>0.00000129</izz> <!-- 0.01/7776 ≈ 1.286e-6 -->
          <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="horizontal_rudder_right_visual">
        <geometry><box><size>0.1666667 0.0083333 0.0833333</size></box></geometry> <!-- 1/6, 0.05/6, 0.5/6 -->
        <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse><specular>0.2 0.5 0.8 1</specular></material>
      </visual>
      <collision name="horizontal_rudder_right_collision">
        <geometry><box><size>0.05 0.0083333 0.0833333</size></box></geometry> <!-- 0.3/6=0.05 -->
      </collision>
    </link>
    <joint name="horizontal_rudder_right_joint" type="revolute">
      <parent>body</parent>
      <child>horizontal_rudder_right</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.785</lower><upper>0.785</upper><effort>10</effort><velocity>1.0</velocity></limit>
        <dynamics><damping>10</damping></dynamics>
      </axis>
    </joint>

    <!-- Левый горизонтальный руль -->
    <link name="horizontal_rudder_left">
      <pose>-0.6666667 -0.2833333 0 1.5708 0 1.5708</pose>
      <inertial>
        <mass>0.02315</mass>
        <inertia>
          <ixx>0.00000129</ixx> <iyy>0.00000129</iyy> <izz>0.00000129</izz>
          <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="horizontal_rudder_left_visual">
        <geometry><box><size>0.1666667 0.0083333 0.0833333</size></box></geometry>
        <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.5 0.9 0.2 1</diffuse><specular>0.2 0.5 0.8 1</specular></material>
      </visual>
      <collision name="horizontal_rudder_left_collision">
        <geometry><box><size>0.05 0.0083333 0.0833333</size></box></geometry>
      </collision>
    </link>
    <joint name="horizontal_rudder_left_joint" type="revolute">
      <parent>body</parent>
      <child>horizontal_rudder_left</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.785</lower><upper>0.785</upper><effort>10</effort><velocity>1.0</velocity></limit>
        <dynamics><damping>10</damping></dynamics>
      </axis>
    </joint>

    <!-- Плагины управления горизонтальными рулями (разные топики) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>horizontal_rudder_right_joint</joint_name>
      <topic>/model/submarine/joint/horizontal_rudder_right/cmd_position</topic>
      <p_gain>10</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>horizontal_rudder_left_joint</joint_name>
      <topic>/model/submarine/joint/horizontal_rudder_left/cmd_position</topic>
      <p_gain>10</p_gain>
    </plugin>

    <!-- ========== ВЕРТИКАЛЬНЫЙ РУЛЬ ========== -->
    <link name="vertical_rudder">
      <pose>-0.6666667 0 -0.2833333 1.5708 1.5708 0</pose> <!-- (-4)/6, (-1.7)/6 = -0.28333 -->
      <inertial>
        <mass>0.02315</mass>
        <inertia>
          <ixx>0.00000129</ixx> <iyy>0.00000129</iyy> <izz>0.00000129</izz>
          <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="vertical_rudder_visual">
        <geometry><box><size>0.1666667 0.1666667 0.005</size></box></geometry> <!-- 1/6, 1/6, 0.03/6=0.005 -->
        <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse><specular>0.2 0.5 0.8 1</specular></material>
      </visual>
      <collision name="vertical_rudder_collision">
        <geometry><box><size>0.0333333 0.0666667 0.005</size></box></geometry> <!-- 0.2/6, 0.4/6, 0.03/6 -->
      </collision>
    </link>
    <joint name="vertical_rudder_joint" type="revolute">
      <parent>body</parent>
      <child>vertical_rudder</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.785</lower><upper>0.785</upper><effort>10</effort><velocity>1.0</velocity></limit>
        <dynamics><damping>10</damping></dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>vertical_rudder_joint</joint_name>
      <topic>/model/submarine/joint/vertical_rudder/cmd_position</topic>
      <p_gain>10</p_gain>
    </plugin>

    <!-- ========== ГИДРОДИНАМИКА РУЛЕЙ (LiftDrag) ========== -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <link_name>vertical_rudder</link_name>
      <area>0.01</area>   <!-- 0.08 / 36 -->
      <cla>1.2</cla> <cla_stall>-0.2</cla_stall>
      <cda>0.5</cda> <cda_stall>1.5</cda_stall>
      <alpha_stall>1.2</alpha_stall> <a0>0</a0>
      <upward>0 0 1</upward>
      <forward>0 1 0</forward>
      <cp>-0.6666667 0 -0.2833333</cp>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <link_name>horizontal_rudder_right</link_name>
      <area>0.01</area>  <!-- 0.15 / 36 -->
      <cla>1.2</cla> <cla_stall>-0.2</cla_stall>
      <cda>0.5</cda> <cda_stall>1.5</cda_stall>
      <alpha_stall>1.2</alpha_stall> <a0>0</a0>
      <upward>0 1 0</upward>
      <forward>0 0 1</forward>
      <cp>-0.6666667 0.2833333 0 </cp>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <link_name>horizontal_rudder_left</link_name>
      <area>0.01</area>
      <cla>1.2</cla> <cla_stall>-0.2</cla_stall>
      <cda>0.5</cda> <cda_stall>1.5</cda_stall>
      <alpha_stall>1.2</alpha_stall> <a0>0</a0>
      <upward>0 1 0</upward>
      <forward>0 0 1</forward>
      <cp>-0.6666667 -0.2833333 0 </cp>
    </plugin>

     <!-- ========== ПЛАГИН ОДОМЕТРИИ ========== -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <topic>/model/submarine/odometry</topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>submarine/body</robot_base_frame>
    </plugin>


      <!-- ПЛАГИН ПЛАВУЧЕСТИ УДАЛЁН – ОН ДОЛЖЕН БЫТЬ В МИРЕ -->




    <!-- Балластные баки -->
    <link name="ballast_fl">
      <pose>0.45 0 -0.2 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
